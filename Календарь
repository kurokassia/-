<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Мобильный календарь</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        .calendar-container {
            width: 100%;
            max-width: 400px;
            background-color: white;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
            overflow: hidden;
        }

        .calendar-header {
            background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
            color: white;
            padding: 20px;
            text-align: center;
        }

        .month-year {
            font-size: 1.5rem;
            font-weight: 600;
            margin-bottom: 10px;
        }

        .navigation {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .nav-btn {
            background: rgba(255, 255, 255, 0.2);
            border: none;
            color: white;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            font-size: 1.2rem;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .nav-btn:hover {
            background: rgba(255, 255, 255, 0.3);
        }

        .weekdays {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            background-color: #f5f5f5;
            padding: 10px 0;
            border-bottom: 1px solid #eee;
        }

        .weekday {
            text-align: center;
            font-weight: 600;
            color: #555;
            font-size: 0.9rem;
        }

        .days {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 5px;
            padding: 10px;
        }

        .day {
            height: 45px;
            display: flex;
            justify-content: center;
            align-items: center;
            border-radius: 50%;
            cursor: pointer;
            transition: all 0.2s ease;
            font-weight: 500;
        }

        .day:hover {
            background-color: #f0f0f0;
        }

        .current-month {
            color: #333;
        }

        .other-month {
            color: #bbb;
        }

        .today {
            background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
            color: white;
            font-weight: 600;
        }

        .selected {
            background-color: #2575fc;
            color: white;
        }

        .events-indicator {
            position: relative;
        }

        .events-indicator::after {
            content: '';
            position: absolute;
            bottom: 5px;
            left: 50%;
            transform: translateX(-50%);
            width: 4px;
            height: 4px;
            background-color: #ff4757;
            border-radius: 50%;
        }

        .today.events-indicator::after {
            background-color: white;
        }

        .calendar-footer {
            padding: 15px;
            text-align: center;
            border-top: 1px solid #eee;
            font-size: 0.9rem;
            color: #666;
        }
    </style>
</head>
<body>
    <div class="calendar-container">
        <div class="calendar-header">
            <div class="month-year" id="month-year">Январь 2023</div>
            <div class="navigation">
                <button class="nav-btn" id="prev-month">&#10094;</button>
                <button class="nav-btn" id="today-btn">Сегодня</button>
                <button class="nav-btn" id="next-month">&#10095;</button>
            </div>
        </div>
        
        <div class="weekdays">
            <div class="weekday">Пн</div>
            <div class="weekday">Вт</div>
            <div class="weekday">Ср</div>
            <div class="weekday">Чт</div>
            <div class="weekday">Пт</div>
            <div class="weekday">Сб</div>
            <div class="weekday">Вс</div>
        </div>
        
        <div class="days" id="days-container">
            <!-- Дни будут добавлены через JavaScript -->
        </div>
        
        <div class="calendar-footer">
            <div id="selected-date">Выберите дату</div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const monthYearElement = document.getElementById('month-year');
            const daysContainer = document.getElementById('days-container');
            const prevMonthBtn = document.getElementById('prev-month');
            const nextMonthBtn = document.getElementById('next-month');
            const todayBtn = document.getElementById('today-btn');
            const selectedDateElement = document.getElementById('selected-date');
            
            let currentDate = new Date();
            let selectedDate = new Date();
            
            // Месяцы на русском
            const months = [
                'Январь', 'Февраль', 'Март', 'Апрель', 'Май', 'Июнь',
                'Июль', 'Август', 'Сентябрь', 'Октябрь', 'Ноябрь', 'Декабрь'
            ];
            
            // Дни недели на русском
            const weekdays = ['Пн', 'Вт', 'Ср', 'Чт', 'Пт', 'Сб', 'Вс'];
            
            // События для демонстрации
            const events = {
                '2023-10-15': 'Встреча с клиентом',
                '2023-10-20': 'День рождения',
                '2023-10-25': 'Поездка',
                '2023-11-05': 'Конференция',
                '2023-11-12': 'Врач',
                '2023-11-18': 'Ужин с друзьями'
            };
            
            // Функция для обновления календаря
            function updateCalendar() {
                const year = currentDate.getFullYear();
                const month = currentDate.getMonth();
                
                // Обновляем заголовок
                monthYearElement.textContent = `${months[month]} ${year}`;
                
                // Очищаем контейнер с днями
                daysContainer.innerHTML = '';
                
                // Получаем первый день месяца и день недели
                const firstDay = new Date(year, month, 1);
                const firstDayWeekday = firstDay.getDay();
                // Корректируем для понедельника как первого дня недели
                const startingDay = firstDayWeekday === 0 ? 6 : firstDayWeekday - 1;
                
                // Получаем последний день месяца
                const lastDay = new Date(year, month + 1, 0);
                const daysInMonth = lastDay.getDate();
                
                // Получаем последний день предыдущего месяца
                const prevMonthLastDay = new Date(year, month, 0).getDate();
                
                // Добавляем дни предыдущего месяца
                for (let i = startingDay - 1; i >= 0; i--) {
                    const day = document.createElement('div');
                    day.className = 'day other-month';
                    day.textContent = prevMonthLastDay - i;
                    daysContainer.appendChild(day);
                }
                
                // Добавляем дни текущего месяца
                const today = new Date();
                for (let i = 1; i <= daysInMonth; i++) {
                    const day = document.createElement('div');
                    day.className = 'day current-month';
                    
                    // Проверяем, является ли день сегодняшним
                    if (i === today.getDate() && 
                        month === today.getMonth() && 
                        year === today.getFullYear()) {
                        day.classList.add('today');
                    }
                    
                    // Проверяем, является ли день выбранным
                    if (i === selectedDate.getDate() && 
                        month === selectedDate.getMonth() && 
                        year === selectedDate.getFullYear()) {
                        day.classList.add('selected');
                    }
                    
                    // Проверяем, есть ли события в этот день
                    const dateString = `${year}-${String(month + 1).padStart(2, '0')}-${String(i).padStart(2, '0')}`;
                    if (events[dateString]) {
                        day.classList.add('events-indicator');
                    }
                    
                    day.textContent = i;
                    day.dataset.date = dateString;
                    
                    // Добавляем обработчик клика
                    day.addEventListener('click', function() {
                        selectDate(new Date(year, month, i));
                    });
                    
                    daysContainer.appendChild(day);
                }
                
                // Добавляем дни следующего месяца
                const totalCells = 42; // 6 строк по 7 дней
                const remainingCells = totalCells - (startingDay + daysInMonth);
                
                for (let i = 1; i <= remainingCells; i++) {
                    const day = document.createElement('div');
                    day.className = 'day other-month';
                    day.textContent = i;
                    daysContainer.appendChild(day);
                }
                
                // Обновляем выбранную дату в футере
                updateSelectedDateText();
            }
            
            // Функция для выбора даты
            function selectDate(date) {
                selectedDate = date;
                updateCalendar();
            }
            
            // Функция для обновления текста выбранной даты
            function updateSelectedDateText() {
                const options = { 
                    weekday: 'long', 
                    year: 'numeric', 
                    month: 'long', 
                    day: 'numeric' 
                };
                const dateString = selectedDate.toLocaleDateString('ru-RU', options);
                
                // Проверяем, есть ли события для выбранной даты
                const formattedDate = `${selectedDate.getFullYear()}-${String(selectedDate.getMonth() + 1).padStart(2, '0')}-${String(selectedDate.getDate()).padStart(2, '0')}`;
                const eventText = events[formattedDate] ? ` • ${events[formattedDate]}` : '';
                
                selectedDateElement.textContent = dateString + eventText;
            }
            
            // Обработчики событий для кнопок навигации
            prevMonthBtn.addEventListener('click', function() {
                currentDate.setMonth(currentDate.getMonth() - 1);
                updateCalendar();
            });
            
            nextMonthBtn.addEventListener('click', function() {
                currentDate.setMonth(currentDate.getMonth() + 1);
                updateCalendar();
            });
            
            todayBtn.addEventListener('click', function() {
                currentDate = new Date();
                selectDate(new Date());
            });
            
            // Инициализация календаря
            updateCalendar();
        });
    </script>
</body>
</html>
